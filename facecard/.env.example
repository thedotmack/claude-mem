# ─────────────────────────────────────────────────────────────────────────
# FACE CARD — environment configuration
# Copy to .env.local for development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── Database / Auth / Storage (REQUIRED) ────────────────────────────────
# Supabase project settings → API. The publishable key is safe in the browser;
# RLS is what actually protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Canonical public origin, used for OAuth redirects and share links.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── AI providers (ALL OPTIONAL) ─────────────────────────────────────────
# Every capability ships with a working built-in engine. Setting a provider
# below swaps that capability to a hosted model. Keys are read server-side
# only and are never exposed to the browser.

# LLM — rewrites scene dialogue in the character's voice.
#   builtin (default) | anthropic | openai
LLM_PROVIDER=builtin
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# IMAGE — scene stills. builtin renders a deterministic cinematic frame.
#   builtin (default) | fal | replicate
IMAGE_PROVIDER=builtin
FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# VIDEO — the most expensive capability. builtin animates the still with the
# camera move the emotion engine specified.
#   builtin (default) | fal
VIDEO_PROVIDER=builtin
FAL_VIDEO_MODEL=fal-ai/ltx-video

# VOICE — builtin performs lines with the device's own speech synthesis.
#   builtin (default) | elevenlabs
VOICE_PROVIDER=builtin
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# MUSIC — builtin is a procedural WebAudio score driven by emotional state.
MUSIC_PROVIDER=builtin

# MODERATION — builtin is a server-side ruleset.
#   builtin (default) | openai
MODERATION_PROVIDER=builtin
