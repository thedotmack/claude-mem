# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Optional production mode. Configure every value in this section to switch
# from browser storage/password auth to Neon, Upstash, and Sign in with Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# claude-mem memory. Key from https://cmem.ai/pro/key (saving needs a Pro key).
CLAUDE_MEM_API_KEY=
# Optional: project that the agent's saves land in (default: eve-agent).
CLAUDE_MEM_PROJECT=
# Production mode only: the one Sign in with Vercel email that gets memory.
CLAUDE_MEM_OWNER_EMAIL=
# iMessage only: your phone number or Apple ID; other senders get no memory.
CLAUDE_MEM_OWNER_PHONE=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=
