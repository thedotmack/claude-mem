{
  "name": "claude-mem-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "pnpm build:eve && pnpm build:web",
    "build:eve": "eve build",
    "build:web": "next build --turbopack apps/web",
    "db:generate": "drizzle-kit generate --config apps/web/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config apps/web/drizzle.config.ts",
    "db:migrate:production": "vercel env run -e production -- pnpm db:migrate",
    "db:push": "drizzle-kit push --config apps/web/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config apps/web/drizzle.config.ts",
    "dev": "next dev apps/web",
    "dev:eve": "eve dev",
    "dev:all": "vercel dev --local",
    "dev:web": "next dev apps/web",
    "start:eve": "eve start",
    "typecheck": "next typegen apps/web && tsgo --noEmit -p apps/web/tsconfig.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@shikijs/core": "4.3.1",
    "@shikijs/engine-javascript": "4.3.1",
    "@shikijs/engine-oniguruma": "4.3.1",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@upstash/redis": "1.38.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/connect": "^2.5.2",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.137",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "claude-mem": "^15.17.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "eve": "^0.84.0",
    "lucide-react": "1.33.0",
    "next": "16.4.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.3.1",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
